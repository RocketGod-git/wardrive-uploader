<?xml version="1.0" encoding="UTF-8"?>
<!-- MSI installer for the WDGWars Uploader. Wraps the self-contained PyInstaller
     exe (built to dist/WDGWarsUploader.exe). Build with build_msi.ps1.
     candle -arch x64 -dExeSrc=<path-to-exe> installer\Product.wxs; light ... -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="WDGWars Uploader" Language="1033" Version="$(var.ProductVersion)"
           Manufacturer="RocketGod" UpgradeCode="E7F3C9A2-4B6D-4E1F-9C3A-2D5B8F1A6C40">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64"
             Description="WDGWars ADS-B + Mesh live uploader" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of WDGWars Uploader is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="$(var.ExeSrc)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/RocketGod-git/wardrive-uploader" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="WDGWars Uploader" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ProgramMenuDir" Name="WDGWars Uploader" />
      </Directory>
      <Directory Id="DesktopFolder" />
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="MainExe" Guid="*" Win64="yes">
        <File Id="WDGWarsUploaderExe" Name="WDGWarsUploader.exe" Source="$(var.ExeSrc)" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuDir" Name="WDGWars Uploader"
                    Description="WDGWars ADS-B + Mesh Uploader" WorkingDirectory="INSTALLFOLDER"
                    Icon="AppIcon" Advertise="yes" />
          <Shortcut Id="DesktopShortcut" Directory="DesktopFolder" Name="WDGWars Uploader"
                    Description="WDGWars ADS-B + Mesh Uploader" WorkingDirectory="INSTALLFOLDER"
                    Icon="AppIcon" Advertise="yes" />
        </File>
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ProgramMenuDir">
      <Component Id="ProgramMenuDirComponent" Guid="*" Win64="yes">
        <RemoveFolder Id="RemoveProgramMenuDir" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\RocketGod\WDGWarsUploader" Name="installed"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Main" Title="WDGWars Uploader" Level="1">
      <ComponentRef Id="MainExe" />
      <ComponentRef Id="ProgramMenuDirComponent" />
    </Feature>
  </Product>
</Wix>
